# WoterClip Configuration Template
# Copy this file to .env.local and fill in your values

# Linear API (optional — only needed for Linear backend)
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here

# SQLite Backend (optional — defaults to .woterclip/woterclip.db)
# WOTERCLIP_DB_PATH=.woterclip/woterclip.db

# Webhook Configuration (optional — only needed for webhook integrations)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret_here
WEBHOOK_RECEIVER_HOST=localhost
WEBHOOK_RECEIVER_PORT=3000
WEBHOOK_RECEIVER_TOKEN=your_receiver_auth_token_here

# Logging (optional)
# WOTERCLIP_LOG_LEVEL=info
# WOTERCLIP_LOG_FILE=.woterclip/logs/heartbeat.log
